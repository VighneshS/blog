---
const skillGroups = [
  {
    category: 'Generative & Agentic AI',
    color: 'purple',
    icon: '🤖',
    skills: ['Agentic AI', 'MCP Servers & Tools', 'MCP Apps', 'Multi-Agent Orchestration', 'RAG / Graph RAG', 'Prompt Engineering', 'Claude', 'Gemini', 'OpenAI', 'AWS Bedrock / AgentCore', 'Mastra', 'Google ADK'],
  },
  {
    category: 'AI Security & DevSecOps',
    color: 'pink',
    icon: '🛡️',
    skills: ['Agent Auth (SigV4 + STS)', 'OAuth 2.1 / PKCE', 'AWS WAF', 'Threat Modelling', 'Pen-test Remediation', 'Aikido', 'Trivy', 'gitleaks', 'Least-privilege IAM', 'ISO 27001'],
  },
  {
    category: 'Cloud',
    color: 'orange',
    icon: '☁️',
    skills: ['AWS ECS Fargate', 'ALB', 'IAM / STS', 'KMS', 'Secrets Manager', 'DynamoDB', 'RDS', 'GCP Vertex AI', 'Cloud Run', 'IAP', 'Workload Identity Federation'],
  },
  {
    category: 'IaC & DevOps',
    color: 'orange',
    icon: '🔧',
    skills: ['Terraform', 'Pulumi', 'Docker (Distroless)', 'Kubernetes / Helm', 'Bitbucket Pipelines', 'GitHub Actions', 'AWS CodePipeline', 'k6 Load Testing'],
  },
  {
    category: 'Languages',
    color: 'green',
    icon: '💻',
    skills: ['TypeScript', 'Python', 'Node.js', 'Go', 'Java', 'SQL'],
  },
  {
    category: 'Backend & Data',
    color: 'blue',
    icon: '⚙️',
    skills: ['NestJS', 'Spring Boot', 'REST APIs', 'Webhooks', 'SSE / Streamable HTTP', 'PostgreSQL', 'DynamoDB', 'Elasticsearch', 'Redis'],
  },
  {
    category: 'Frontend',
    color: 'pink',
    icon: '🎨',
    skills: ['React', 'MobX', 'Zustand', 'Tailwind CSS', 'Storybook', 'Astro'],
  },
  {
    category: 'ML Foundations',
    color: 'blue',
    icon: '🧠',
    skills: ['PyTorch', 'TensorFlow', 'Scikit-learn', 'CNNs', 'U-Net', 'NLP Basics'],
  },
];

const colorClass: Record<string, string> = {
  blue:   'tag',
  purple: 'tag tag-purple',
  orange: 'tag tag-orange',
  green:  'tag tag-green',
  pink:   'tag tag-pink',
};
---

<section id="skills" style="background: linear-gradient(180deg, var(--bg) 0%, var(--bg2) 50%, var(--bg) 100%);">
  <div class="max-w-7xl mx-auto px-5 sm:px-6">

    <div class="text-center mb-14 reveal">
      <div class="section-label" style="display: inline-flex;">Skills & Technologies</div>
      <h2 class="font-display font-bold text-4xl text-white mb-2 mt-3">What I Work With</h2>
      <div class="section-divider" style="margin-left: auto; margin-right: auto;"></div>
      <p class="text-slate-500 max-w-xl mx-auto text-sm">
        The tools I use to build and secure production agentic-AI systems.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {skillGroups.map(({ category, color, icon, skills }, i) => (
        <div class={`glass rounded-2xl p-5 hover:border-sky-400/30 transition-all reveal reveal-delay-${Math.min((i % 4) + 1, 4)}`}>
          <div class="flex items-center gap-2.5 mb-4">
            <span class="text-xl">{icon}</span>
            <h3 class="font-display font-semibold text-sm text-white leading-tight">{category}</h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {skills.map(skill => (
              <span class={colorClass[color] ?? 'tag'}>{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
