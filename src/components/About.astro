---
import { yearsExp } from '../lib/experience';

// Full-time years only, matching the resume
const stats = [
  { value: `~${yearsExp}`, label: 'Years Experience',                icon: '⚡' },
  { value: '2',            label: 'Countries Worked',                icon: '🌏' },
  { value: '2',            label: 'Publications',                    icon: '📄' },
  { value: '2',            label: 'AI Platforms Pen-test Hardened',  icon: '🛡️' },
];
---

<section id="about">
  <div class="max-w-7xl mx-auto px-5 sm:px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Text -->
      <div class="reveal">
        <div class="section-label">About Me</div>
        <h2 class="font-display font-bold text-4xl text-white mb-2">Who I Am</h2>
        <div class="section-divider"></div>

        <div class="space-y-4 text-slate-400 leading-relaxed text-[0.95rem]">
          <p>
            I'm a <span class="text-sky-400 font-medium">Senior AI Engineer</span> based in Chennai, India,
            with ~{yearsExp} years of software engineering experience.
          </p>
          <p>
            I build <span class="text-indigo-400 font-medium">production agentic-AI systems</span> — MCP tooling,
            agent authentication and LLM automation on AWS and GCP — and the
            <span class="text-sky-400 font-medium">security</span> that lets them pass enterprise reviews and
            external pen-tests.
          </p>
          <p>
            I've worked with <span class="text-emerald-400 font-medium">Claude, Gemini and OpenAI</span> models,
            MCP servers and multi-agent frameworks. I hold an
            <span class="text-sky-400 font-medium">MS in Computer Science</span> from UT Arlington (thesis track)
            and co-authored a peer-reviewed paper at ACSAC 2023.
          </p>
          <p>
            Outside work I build side projects, such as an LLM multi-agent trading-research platform and a
            land-intelligence MCP server, both running on Google Cloud.
          </p>
        </div>

        <div class="flex flex-wrap gap-3 mt-8">
          <a
            href="#contact"
            class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5"
            style="background: linear-gradient(135deg, #0284c7, #4f46e5); box-shadow: 0 4px 20px rgba(2,132,199,0.25);"
          >
            Let's Connect
          </a>
          <a
            href="#experience"
            class="px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-300 border border-slate-700 hover:border-sky-500/50 hover:text-sky-400 transition-all"
          >
            See My Work
          </a>
        </div>
      </div>

      <!-- Stats grid -->
      <div class="grid grid-cols-2 gap-4 reveal reveal-delay-2">
        {stats.map(({ value, label, icon }) => (
          <div class="glass rounded-2xl p-6 text-center hover:border-sky-400/30 transition-all group cursor-default">
            <div class="text-3xl mb-2">{icon}</div>
            <div class="font-display font-bold text-3xl text-white mb-1 group-hover:text-sky-400 transition-colors">{value}</div>
            <div class="text-slate-500 text-sm">{label}</div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
